        "phrases": [
          {
            "id": "S01_F1",
            "text": "O sapato do Nico pediu demissão.",
            "start_sec": 0.0,
            "end_sec": 2.62,
            "wav_rms_dbfs": -15.88,
            "mp4_rms_dbfs": -15.89,
            "wav_peak_dbfs": -1.19,
            "mp4_peak_dbfs": -1.19,
            "rms_diff_db": 0.01
          },
          {
            "id": "S01_F2",
            "text": "E na vila dele, ninguém usava dinheiro.",
            "start_sec": 3.06,
            "end_sec": 5.64,
            "wav_rms_dbfs": -16.84,
            "mp4_rms_dbfs": -16.85,
            "wav_peak_dbfs": -1.68,
            "mp4_peak_dbfs": -1.7,
            "rms_diff_db": 0.01
          },
          {
            "id": "S02_F1",
            "text": "Ele tinha quarenta quilos de batata e achou que dava pra trocar por um par novo.",
            "start_sec": 6.18,
            "end_sec": 10.88,
            "wav_rms_dbfs": -17.28,
            "mp4_rms_dbfs": -17.29,
            "wav_peak_dbfs": -1.61,
            "mp4_peak_dbfs": -1.62,
            "rms_diff_db": 0.01
          },
          {
            "id": "S02_F2",
            "text": "Só que o sapateiro não queria batatas.",
            "start_sec": 11.4,
            "end_sec": 14.74,
            "wav_rms_dbfs": -19.28,
            "mp4_rms_dbfs": -19.29,
            "wav_peak_dbfs": -1.42,
            "mp4_peak_dbfs": -1.4,
            "rms_diff_db": 0.01
          },
          {
            "id": "S02_F3",
            "text": "Queria leite.",
            "start_sec": 15.22,
            "end_sec": 16.74,
            "wav_rms_dbfs": -18.03,
            "mp4_rms_dbfs": -18.05,
            "wav_peak_dbfs": -1.77,
            "mp4_peak_dbfs": -1.76,
            "rms_diff_db": 0.02
          },
          {
            "id": "S02_F4",
            "text": "Nico... aí complicou.",
            "start_sec": 17.36,
            "end_sec": 19.38,
            "wav_rms_dbfs": -19.16,
            "mp4_rms_dbfs": -19.17,
            "wav_peak_dbfs": -1.83,
            "mp4_peak_dbfs": -1.84,
            "rms_diff_db": 0.01
          },
          {
            "id": "S03_F1",
            "text": "Mas Nico teve uma ideia.",
            "start_sec": 19.76,
            "end_sec": 21.58,
            "wav_rms_dbfs": -17.7,
            "mp4_rms_dbfs": -17.71,
            "wav_peak_dbfs": -3.89,
            "mp4_peak_dbfs": -3.94,
            "rms_diff_db": 0.01
          },
          {
            "id": "S03_F2",
            "text": "O pescador queria batatas. Então ele conseguiu um peixe.",
            "start_sec": 22.22,
            "end_sec": 26.54,
            "wav_rms_dbfs": -17.66,
            "mp4_rms_dbfs": -17.68,
            "wav_peak_dbfs": -1.2,
            "mp4_peak_dbfs": -1.24,
            "rms_diff_db": 0.02
          },
          {
            "id": "S03_F3",
            "text": "E o lenhador queria peixe. Pronto, conseguiu lenha também.",
            "start_sec": 27.34,
            "end_sec": 31.18,
            "wav_rms_dbfs": -17.43,
            "mp4_rms_dbfs": -17.44,
            "wav_peak_dbfs": -1.03,
            "mp4_peak_dbfs": -1.12,
            "rms_diff_db": 0.01
          },
          {
            "id": "S03_F4",
            "text": "Pera aí... duas trocas seguidas dando certo?",
            "start_sec": 31.18,
            "end_sec": 34.86,
            "wav_rms_dbfs": -20.86,
            "mp4_rms_dbfs": -20.88,
            "wav_peak_dbfs": -1.93,
            "mp4_peak_dbfs": -1.93,
            "rms_diff_db": 0.02
          },
          {
            "id": "S03_F5",
            "text": "Isso tá fácil demais.",
            "start_sec": 35.66,
            "end_sec": 36.72,
            "wav_rms_dbfs": -21.64,
            "mp4_rms_dbfs": -21.67,
            "wav_peak_dbfs": -5.39,
            "mp4_peak_dbfs": -5.44,
            "rms_diff_db": 0.03
          },
          {
            "id": "S04_F1",
            "text": "Pois é.",
            "start_sec": 37.38,
            "end_sec": 38.18,
            "wav_rms_dbfs": -18.9,
            "mp4_rms_dbfs": -18.93,
            "wav_peak_dbfs": -3.71,
            "mp4_peak_dbfs": -3.72,
            "rms_diff_db": 0.03
          },
          {
            "id": "S04_F2",
            "text": "O leiteiro não queria lenha. Queria ovos.",
            "start_sec": 38.78,
            "end_sec": 41.6,
            "wav_rms_dbfs": -17.0,
            "mp4_rms_dbfs": -17.01,
            "wav_peak_dbfs": -3.0,
            "mp4_peak_dbfs": -3.08,
            "rms_diff_db": 0.01
          },
          {
            "id": "S04_F3",
            "text": "E o vendedor de ovos queria farinha.",
            "start_sec": 42.0,
            "end_sec": 43.9,
            "wav_rms_dbfs": -17.02,
            "mp4_rms_dbfs": -17.03,
            "wav_peak_dbfs": -2.86,
            "mp4_peak_dbfs": -2.86,
            "rms_diff_db": 0.01
          },
          {
            "id": "S04_F4",
            "text": "E quem vendia farinha...",
            "start_sec": 44.68,
            "end_sec": 45.76,
            "wav_rms_dbfs": -17.38,
            "mp4_rms_dbfs": -17.39,
            "wav_peak_dbfs": -2.86,
            "mp4_peak_dbfs": -2.89,
            "rms_diff_db": 0.01
          },
          {
            "id": "S04_F5",
            "text": "Nico, você quer comprar um sapato ou abrir uma transportadora?",
            "start_sec": 47.42,
            "end_sec": 51.46,
            "wav_rms_dbfs": -18.16,
            "mp4_rms_dbfs": -18.18,
            "wav_peak_dbfs": -1.65,
            "mp4_peak_dbfs": -1.68,
            "rms_diff_db": 0.02
          },
          {
            "id": "S05_F1",
            "text": "O problema não era faltar coisa pra trocar.",
            "start_sec": 51.92,
            "end_sec": 55.04,
            "wav_rms_dbfs": -15.26,
            "mp4_rms_dbfs": -15.28,
            "wav_peak_dbfs": -1.01,
            "mp4_peak_dbfs": -1.01,
            "rms_diff_db": 0.02
          },
          {
            "id": "S05_F2",
            "text": "Era encontrar alguém que quisesse exatamente o que ele tinha, bem naquela hora.",
            "start_sec": 55.26,
            "end_sec": 60.66,
            "wav_rms_dbfs": -17.73,
            "mp4_rms_dbfs": -17.75,
            "wav_peak_dbfs": -2.3,
            "mp4_peak_dbfs": -2.36,
            "rms_diff_db": 0.02
          },
          {
            "id": "S06_F1",
            "text": "Até que a feira resolveu testar uma ideia.",
            "start_sec": 61.26,
            "end_sec": 64.64,
            "wav_rms_dbfs": -15.03,
            "mp4_rms_dbfs": -15.05,
            "wav_peak_dbfs": -1.72,
            "mp4_peak_dbfs": -1.76,
            "rms_diff_db": 0.02
          },
          {
            "id": "S06_F2",
            "text": "Todo mundo passaria a aceitar uma mesma ficha como pagamento.",
            "start_sec": 65.22,
            "end_sec": 69.04,
            "wav_rms_dbfs": -15.53,
            "mp4_rms_dbfs": -15.55,
            "wav_peak_dbfs": -1.28,
            "mp4_peak_dbfs": -1.25,
            "rms_diff_db": 0.02
          },
          {
            "id": "S06_F3",
            "text": "Nico vendeu batatas, recebeu fichas e finalmente comprou os sapatos.",
            "start_sec": 69.8,
            "end_sec": 74.8,
            "wav_rms_dbfs": -16.53,
            "mp4_rms_dbfs": -16.55,
            "wav_peak_dbfs": -1.34,
            "mp4_peak_dbfs": -1.38,
            "rms_diff_db": 0.02
          },
          {
            "id": "S06_F4",
            "text": "E o sapateiro? Usou as mesmas fichas pra comprar leite.",
            "start_sec": 75.6,
            "end_sec": 79.28,
            "wav_rms_dbfs": -15.96,
            "mp4_rms_dbfs": -15.98,
            "wav_peak_dbfs": -1.45,
            "mp4_peak_dbfs": -1.38,
            "rms_diff_db": 0.02
          },
          {
            "id": "S06_F5",
            "text": "Agora sim!",
            "start_sec": 80.1,
            "end_sec": 81.26,
            "wav_rms_dbfs": -16.02,
            "mp4_rms_dbfs": -16.04,
            "wav_peak_dbfs": -1.41,
            "mp4_peak_dbfs": -1.41,
            "rms_diff_db": 0.02
          },
          {
            "id": "S07_F1",
            "text": "Mas tem um detalhe.",
            "start_sec": 81.48,
            "end_sec": 83.14,
            "wav_rms_dbfs": -16.28,
            "mp4_rms_dbfs": -16.3,
            "wav_peak_dbfs": -1.8,
            "mp4_peak_dbfs": -1.8,
            "rms_diff_db": 0.02
          },
          {
            "id": "S07_F2",
            "text": "Por que alguém aceitaria um pedaço de madeira como pagamento?",
            "start_sec": 83.44,
            "end_sec": 86.72,
            "wav_rms_dbfs": -15.64,
            "mp4_rms_dbfs": -15.66,
            "wav_peak_dbfs": -1.41,
            "mp4_peak_dbfs": -1.35,
            "rms_diff_db": 0.02
          },
          {
            "id": "S07_F3",
            "text": "Porque confiava que outras pessoas também aceitariam.",
            "start_sec": 86.72,
            "end_sec": 90.42,
            "wav_rms_dbfs": -16.46,
            "mp4_rms_dbfs": -16.49,
            "wav_peak_dbfs": -1.37,
            "mp4_peak_dbfs": -1.42,
            "rms_diff_db": 0.03
          },
          {
            "id": "S07_F4",
            "text": "Sem isso, a ficha não passaria de um pedaço de madeira.",
            "start_sec": 90.94,
            "end_sec": 94.9,
            "wav_rms_dbfs": -16.07,
            "mp4_rms_dbfs": -16.1,
            "wav_peak_dbfs": -1.25,
            "mp4_peak_dbfs": -1.28,
            "rms_diff_db": 0.03
          },
          {
            "id": "S08_F1",
            "text": "Agora me conta: se não existisse dinheiro, o que você ofereceria por um par de sapatos?",
            "start_sec": 95.38,
            "end_sec": 101.66,
            "wav_rms_dbfs": -16.59,
            "mp4_rms_dbfs": -16.61,
